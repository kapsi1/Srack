{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"paths": {
			"*": ["node_modules/*", "src/*"]
		}
	},
	"include": ["src/**/*", "src/generated/**/*"],
	"exclude": ["node_modules"]
}
